/*
 * Rofi Configuration - Search Only (Fuentes Globales)
 * Author: Ricardo
 * Theme: Dark Frosted Glass
 */

* {
    font: "SF Pro 11";
}

configuration {
    modi: "drun";
    show-icons: true;
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";

    display-drun: "";
    drun-display-format: "{name}";
    icon-theme: "WhiteSur";
}

/* =========================
   🖼️ Ventana Principal
   ========================= */
window {
    location: center;
    anchor: center;
    width: 46%;
    height: 52%;
    transparency: "real";
    background-color: rgba(28, 28, 30, 0.90);
    border-radius: 18px;
    border: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

/* =========================
   📦 Contenedor Principal
   ========================= */
mainbox {
    padding: 24px 30px;
    spacing: 16px;
    background-color: rgba(0, 0, 0, 0);
    children: [ inputbar, listview, textbox-dots ];
}

/* =========================
   🔍 Barra de Búsqueda
   ========================= */
inputbar {
    padding: 10px 18px;
    margin: 0px 4%;
    border-radius: 10px;
    background-color: rgba(60, 60, 65, 0.75);
    border: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    children: [ prompt, entry ];
}

prompt {
    enabled: true;
    str: "";
    background-color: rgba(0, 0, 0, 0);
    text-color: rgba(255, 255, 255, 0.9);
    padding: 0px 10px 0px 2px;
}

entry {
    placeholder: "Escribe para buscar...";
    placeholder-color: rgba(170, 170, 175, 0.7);
    text-color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0);
}

/* =========================
   🗂️ Grid de Resultados (4 columnas x 3 líneas)
   ========================= */
listview {
    columns: 4;
    lines: 3;
    spacing: 15px;
    cycle: true;
    dynamic: false;
    scrollbar: false;
    background-color: rgba(0, 0, 0, 0);
    fixed-height: true;
    fixed-columns: true;
}

/* =========================
   🎨 Elementos
   ========================= */
element {
    orientation: vertical;
    padding: 8px 4px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    spacing: 8px;
    children: [ element-icon, element-text ];
}

element selected {
    background-color: rgba(60, 60, 65, 0.5);
    border: 1px;
    border-color: rgba(0, 122, 255, 0.25);
}

element-icon {
    size: 48px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: rgba(0, 0, 0, 0);
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: rgba(255, 255, 255, 0.9);
    font: "SF Pro 10";
    background-color: rgba(0, 0, 0, 0);
}

/* =========================
   🔵 Indicador de Páginas
   ========================= */
textbox-dots {
    expand: false;
    str: "━━  ●  ━━";
    horizontal-align: 0.5;
    padding: 6px 0px 0px 0px;
    background-color: rgba(0, 0, 0, 0);
    text-color: rgba(255, 255, 255, 0.5);
}
